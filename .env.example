# Copie este arquivo para ".env" e preencha com os dados da sua conta Z-API
# (painel Z-API > sua instância > "ID da instância" e "Token").

ZAPI_INSTANCE_ID=
ZAPI_TOKEN=

# Opcional: se a sua conta Z-API exigir o header "Client-Token"
# (painel Z-API > Segurança > Token de segurança da conta)
ZAPI_CLIENT_TOKEN=

# Opcional: uma senha à sua escolha para proteger o endpoint /webhook.
# Se preencher aqui, configure a mesma URL com "?secret=SEU_VALOR" no painel da Z-API.
WEBHOOK_SECRET=

PORT=3000
